rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(appId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid));
    }

    function primaryRole(appId) {
      return userProfile(appId).data.get('role', 'Staff');
    }

    function secondaryRoles(appId) {
      return userProfile(appId).data.get('roles', []);
    }

    function isAdmin(appId) {
      return signedIn() && (
        primaryRole(appId) == 'Administrator' ||
        secondaryRoles(appId).hasAny(['Administrator'])
      );
    }

    function isAdminSite(appId) {
      return signedIn() && (
        primaryRole(appId) == 'Admin Site' ||
        secondaryRoles(appId).hasAny(['Admin Site'])
      );
    }

    // Keep the server-side fallback in sync with MODULE_ACCESS in
    // src/lib/constants.ts. The client falls back to these roles when the
    // rolePermissions document (or an individual module key) does not exist.
    // Without the same fallback here, the UI can show an allowed action while
    // Firestore rejects it with "Missing or insufficient permissions".
    function defaultModuleRoles(moduleKey) {
      return moduleKey == 'advance-payment'
        ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff']
        : moduleKey == 'dashboard'
        ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff', 'Admin Site']
        : moduleKey == 'projects'
          ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Admin Site']
          : moduleKey == 'budget'
            ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff', 'Admin Site']
            : moduleKey == 'pr' || moduleKey == 'pr-table' ||
                moduleKey == 'po' || moduleKey == 'po-table'
              ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff']
              : moduleKey == 'vendor' || moduleKey == 'material'
                ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Procurement', 'Staff']
                : moduleKey == 'invoice'
                  ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Staff']
                  : moduleKey == 'receive'
                    ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Staff', 'Admin Site']
                  : moduleKey == 'billing' || moduleKey == 'pay' ||
                      moduleKey == 'payment-subcontract'
                    ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff']
                    : moduleKey == 'profile' || moduleKey == 'user-manual'
                      ? ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff', 'Admin Site']
                      : moduleKey == 'admin'
                        ? ['Administrator']
                        : moduleKey == 'budget-summary' || moduleKey == 'project-spending'
                          ? ['Administrator', 'MD', 'GM']
                          : [];
    }

    function moduleAllowed(appId, moduleKey) {
      let permissionsPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/settings/rolePermissions;
      let allowedRoles = exists(permissionsPath)
        ? get(permissionsPath).data.get(moduleKey, defaultModuleRoles(moduleKey))
        : defaultModuleRoles(moduleKey);
      return isAdmin(appId) ||
        primaryRole(appId) in allowedRoles ||
        secondaryRoles(appId).hasAny(allowedRoles);
    }

    // Budget Return approval is a cross-document transaction. Keep PM in this
    // narrow server-side allow-list even when an older rolePermissions document
    // does not contain the new budget.acceptBudgetReturn action yet.
    function isBudgetReturnApprover(appId) {
      return signedIn() && (
        primaryRole(appId) in ['Administrator', 'MD', 'GM', 'PM', 'PCM'] ||
        secondaryRoles(appId).hasAny(['Administrator', 'MD', 'GM', 'PM', 'PCM'])
      );
    }

    function changesOnlyBudgetReturnFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function assignedToProject(appId, projectId) {
      return isAdmin(appId) ||
        projectId in userProfile(appId).data.get('assignedProjectIds', []);
    }

    function canCreateInProject(appId) {
      return signedIn() && assignedToProject(appId, request.resource.data.get('projectId', ''));
    }

    function canReadExistingProjectDoc(appId) {
      return signedIn() && assignedToProject(appId, resource.data.get('projectId', ''));
    }

    function canUpdateExistingProjectDoc(appId) {
      return canReadExistingProjectDoc(appId) &&
        assignedToProject(appId, request.resource.data.get('projectId', ''));
    }

    // Material inspection only writes its own metadata. Financial writes keep their existing rules.
    function materialReceiveActionAllowed(appId, action) {
      let permissionsPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/settings/functionPermissions;
      let roles = exists(permissionsPath)
        ? get(permissionsPath).data.get('receive', {}).get(action, ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Staff'])
        : ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Staff'];
      return isAdmin(appId) || primaryRole(appId) in roles || secondaryRoles(appId).hasAny(roles);
    }

    function materialReceiverAllowed(appId) {
      return materialReceiveActionAllowed(appId, 'receive');
    }

    function validMaterialQueueReset(appId) {
      let previous = resource.data;
      let next = request.resource.data;
      let inspection = next.get('materialReceive', {});
      return previous.get('receiveType', '') == 'Material' &&
        !(previous.get('poType', '') in ['SP', 'DC']) &&
        materialPoStatus(previous) in ['Approved', 'Approve', 'Partial Receive', 'paid'] &&
        moduleAllowed(appId, 'receive') && materialReceiveActionAllowed(appId, 'delete') &&
        next.diff(previous).affectedKeys().hasOnly(['status', 'statusNow', 'materialReceiveRequired', 'materialReceive', 'updatedAt']) &&
        next.get('status', '') == 'Approved' && next.get('statusNow', '') == 'Approved' &&
        next.get('materialReceiveRequired', false) && inspection.get('status', '') == 'pending' &&
        inspection.diff(previous.get('materialReceive', {})).affectedKeys().hasOnly(['status']);
    }

    function materialPoStatus(po) {
      let status = po.get('status', '');
      let mirror = po.get('statusNow', '');
      return status in ['Draft', 'Rejected', 'Pending PCM', 'Pending GM', 'PO Edit Pending PCM', 'PO Edit Pending GM', 'Pending Close PO', 'Closed PO', 'Cancelled', 'Canceled']
        ? status : (mirror == '' || mirror == 'Draft' ? status : mirror);
    }

    function validMaterialPoUpdate(appId) {
      let previous = resource.data;
      let next = request.resource.data;
      let changes = next.diff(previous).affectedKeys();
      let inspection = next.get('materialReceive', {});
      return (!previous.get('materialSnapshotLocked', false) || next.get('materialSnapshotLocked', false)) &&
        (!previous.get('materialReceiveRequired', false) || next.get('materialReceiveRequired', false) ||
        (previous.get('status', '') == 'Draft' && !previous.get('materialSnapshotLocked', false) && moduleAllowed(appId, 'po'))) &&
        (!changes.hasAny(['materialReceive']) || validMaterialQueueReset(appId) || (
          changes.hasOnly(['materialReceive']) &&
          previous.get('materialReceiveRequired', false) &&
          previous.get('materialReceive', {}).get('status', '') != 'passed' &&
          !(previous.get('poType', '') in ['SP', 'DC']) &&
          materialPoStatus(previous) in ['Approved', 'Approve', 'Partial Receive', 'Wait Invoice', 'Deposit', 'Invcredit', 'Inpay', 'paid', 'Paid', 'Received'] &&
          moduleAllowed(appId, 'receive') && materialReceiverAllowed(appId) &&
          inspection.keys().hasOnly(['status', 'certificates', 'note', 'confirmedByUid', 'confirmedByName', 'confirmedAt']) &&
          inspection.get('status', '') == 'passed' &&
          inspection.get('certificates', []) is list && inspection.get('note', '') is string &&
          inspection.get('confirmedByUid', '') == request.auth.uid &&
          inspection.get('confirmedAt', null) == request.time
        ));
    }

    function materialReceiveWriteAllowed(appId) {
      let receive = request.resource.data;
      let poId = receive.get('poId', '');
      let poPath = /databases/$(database)/documents/artifacts/$(appId)/public/data/pos/$(poId);
      return poId == '' || !exists(poPath) || !get(poPath).data.get('materialReceiveRequired', false) || (
        moduleAllowed(appId, 'receive') && materialReceiverAllowed(appId) &&
        get(poPath).data.get('materialReceive', {}).get('status', '') == 'passed' &&
        get(poPath).data.get('projectId', '') == receive.get('projectId', '') &&
        !(get(poPath).data.get('poType', '') in ['SP', 'DC']) &&
        (materialPoStatus(get(poPath).data) in ['Approved', 'Approve', 'Partial Receive'] ||
          (materialPoStatus(get(poPath).data) == 'paid' &&
            (get(poPath).data.get('payBeforeReceiveChecked', false) ||
             get(poPath).data.get('receiveType', '').lower().matches('.*pay before.*') ||
             get(poPath).data.get('invoiceMode', '') == 'pay_before_receive'))) &&
        !receive.get('autoCreatedFromPoApproval', false) &&
        !receive.get('autoCreatedFromPayDocument', false) &&
        !receive.get('autoCreatedFromPayBeforeReceiveFlow', false)
      );
    }

    // Advance money is stored in integer satang; all lifecycle/audit writes are atomic.
    function advanceRole(appId, roles) {
      return isAdmin(appId) || primaryRole(appId) in roles || secondaryRoles(appId).hasAny(roles);
    }
    function advanceActionAllowed(appId, action, defaults) {
      let p = /databases/$(database)/documents/artifacts/$(appId)/public/data/settings/functionPermissions;
      let roles = exists(p) ? get(p).data.get('advance-payment', {}).get(action, defaults) : defaults;
      return moduleAllowed(appId, 'advance-payment') && advanceRole(appId, roles);
    }
    function advanceReadable(appId) {
      return moduleAllowed(appId, 'advance-payment') || moduleAllowed(appId, 'payment-subcontract') ||
        moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay');
    }
    function advanceStage(appId, status) {
      return status in ['Pending PD', 'Pending PCM', 'Pending GM', 'Pending MD'] &&
        advanceRole(appId,
          status == 'Pending PD' ? ['PD'] :
          status == 'Pending PCM' ? ['PCM'] :
          status == 'Pending GM' ? ['GM'] : ['MD']);
    }
    function advanceNext(a) {
      return a.status == 'Pending PD' ? 'Pending PCM' : a.status == 'Pending PCM' ? 'Pending GM' :
        a.status == 'Pending GM' && a.amountSatang > 10000000 ? 'Pending MD' : 'Approved';
    }
    function advanceAudit(appId, id, before, after, action) {
      let h = after.history;
      let e = h[h.size() - 1];
      let p = /databases/$(database)/documents/artifacts/$(appId)/public/data/advanceTransactions/$(e.id);
      let audit = getAfter(p).data;
      return h is list && h.size() == before.get('history', []).size() + 1 &&
        h == before.get('history', []).concat([e]) &&
        e.keys().hasOnly(['id', 'action', 'fromStatus', 'toStatus', 'byUid', 'byName', 'note', 'at', 'amountSatang', 'paidDate', 'paymentReference']) &&
        e.action == action && e.fromStatus == before.get('status', '') && e.toStatus == after.status &&
        e.byUid == request.auth.uid && e.byName is string && e.note is string && e.at is timestamp &&
        !exists(p) && audit.diff(e).affectedKeys().hasOnly(['advanceId', 'projectId', 'poId', 'amountSatang', 'createdAt']) &&
        audit.advanceId == id && audit.projectId == after.projectId && audit.poId == after.poId &&
        audit.amountSatang == after.amountSatang && audit.createdAt == request.time;
    }

    function validAdvanceCreate(appId, id, a) {
      let po = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/pos/$(a.poId)).data;
      return a.keys().hasOnly(['status', 'amountSatang', 'paidSatang', 'recoveredSatang', 'projectId', 'poId', 'poNo', 'vendorId', 'vendorName', 'workUnclaimedAmount', 'balanceSnapshot', 'recoveryTerms', 'reason', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'history']) &&
        advanceRole(appId, ['CM', 'PM']) && a.status == 'Pending PD' &&
        a.amountSatang is int && a.amountSatang > 0 && a.amountSatang <= 9007199254740991 && a.paidSatang == 0 && a.recoveredSatang == 0 &&
        po.get('status', '') in ['Approved', 'Approve', 'Partial Receive', 'Received', 'Wait Invoice', 'Deposit', 'Invcredit', 'Inpay', 'paid', 'Paid'] &&
        !po.get('statusNow', '').lower().matches('.*(draft|pending|reject|cancel|closed).*') && a.projectId == po.projectId && a.poNo == po.poNo &&
        a.vendorId != '' && a.vendorId == po.get('vendorId', po.get('supplierId', '')) &&
        a.vendorName == po.get('vendorName', po.get('supplierName', po.get('vendor', ''))) &&
        a.workUnclaimedAmount is number && a.workUnclaimedAmount >= 0 && a.balanceSnapshot is number && a.balanceSnapshot >= 0 &&
        a.reason is string && a.reason.size() > 0 && a.recoveryTerms is string && a.recoveryTerms.size() > 0 &&
        a.createdByUid == request.auth.uid && a.createdByName is string && a.createdAt == request.time && a.updatedAt == request.time &&
        advanceAudit(appId, id, {}, a, 'create');
    }
    function validAdvanceLifecycle(appId, id, b, a) {
      let changed = a.diff(b).affectedKeys();
      return a.updatedAt == request.time && (
        (advanceStage(appId, b.status) && changed.hasOnly(['status', 'history', 'updatedAt', 'rejectionReason']) &&
          ((a.status == advanceNext(b) && a.get('rejectionReason', null) == b.get('rejectionReason', null) && advanceAudit(appId, id, b, a, 'approve')) ||
           (a.status == 'Rejected' && a.rejectionReason is string && a.rejectionReason.size() > 0 &&
             a.history[a.history.size()-1].note == a.rejectionReason && advanceAudit(appId, id, b, a, 'reject')))) ||
        (b.status == 'Approved' && a.status == 'Paid' && b.paidSatang == 0 && b.recoveredSatang == 0 &&
          advanceActionAllowed(appId, 'confirmPay', ['Administrator']) &&
          changed.hasOnly(['status', 'history', 'updatedAt', 'paidSatang', 'paidDate', 'paymentReference', 'paidByUid', 'paidByName', 'paidAt']) &&
          a.paidSatang == b.amountSatang && a.paidDate is string && a.paidDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          a.paymentReference is string && a.paymentReference.size() > 0 && a.paidByUid == request.auth.uid && a.paidByName is string && a.paidAt == request.time &&
          a.history[a.history.size()-1].amountSatang == a.amountSatang && a.history[a.history.size()-1].paidDate == a.paidDate &&
          a.history[a.history.size()-1].paymentReference == a.paymentReference && advanceAudit(appId, id, b, a, 'pay')));
    }
    function recoveryPath(appId, id) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/advanceRecoveries/$(id);
    }
    function advancePath(appId, id) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/advances/$(id);
    }
    function recoveryDocumentPath(appId, kind, id) {
      return /databases/$(database)/documents/artifacts/$(appId)/public/data/$(kind)/$(id);
    }
    function ownRecovery(d) {
      return d.get('advanceRecovery', null) != null && d.advanceRecovery.get('amountSatang', 0) > 0;
    }
    function recoveryEligible(appId, kind, id, d, amount) {
      return d.get('billingNo', '') in ['', null] && d.get('payNo', '') in ['', null] &&
        d.get('inheritedAdvanceRecovery', null) == null && !d.get('isDeposit', false) && !d.get('depositSettled', false) &&
        (kind == 'payments' ? (
          d.get('invoiceId', '') in ['', null] &&
          !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/invoices/$('payment-invoice-' + id)) &&
          (d.status == 'Active' || (amount == 0 && d.status in ['งวดงาน Pending CM', 'งวดงาน Pending PM', 'Reject', 'Rejected', 'Hold', 'Wait Pay']))
        ) : d.get('sourceType', '') != 'payment' && (d.status == 'Draft' || (amount == 0 && d.status == 'Invcredit')));
    }
    function validRecovery(appId, id, r) {
      let p = recoveryPath(appId, id);
      let old = exists(p) ? get(p).data : {};
      let ap = advancePath(appId, r.advanceId);
      let a = get(ap).data;
      let next = getAfter(ap).data;
      let dp = recoveryDocumentPath(appId, r.documentType, r.documentId);
      let d = get(dp).data;
      let nd = getAfter(dp).data;
      return r.keys().hasOnly(['advanceId', 'amountSatang', 'projectId', 'poId', 'documentType', 'documentId', 'updatedAt', 'updatedByUid', 'lastTransactionId']) &&
        r.documentType in ['payments', 'invoices'] && id == r.documentType + '-' + r.documentId &&
        r.amountSatang is int && r.amountSatang >= 0 && r.amountSatang <= 9007199254740991 &&
        r.updatedAt == request.time && r.updatedByUid == request.auth.uid &&
        recoveryActor(appId, r) &&
        (old.get('amountSatang', 0) == 0 || old.advanceId == r.advanceId) &&
        r.projectId == a.projectId && r.poId == a.poId && d.projectId == a.projectId && d.get('vendorId', d.get('contractorId', '')) == a.vendorId &&
        (r.documentType == 'payments' ? (d.get('poId', '') == a.poId || a.poId in d.get('selectedPrIds', [])) : d.poId == a.poId) &&
        a.status == 'Paid' && next.status == 'Paid' && a.paidSatang == a.amountSatang &&
        recoveryEligible(appId, r.documentType, r.documentId, d, r.amountSatang) &&
        r.amountSatang <= math.round(d.amount * 100) &&
        d.get('advanceRecovery', null) == (old.get('amountSatang', 0) == 0 ? null : {'advanceId': old.advanceId, 'amountSatang': old.amountSatang}) &&
        nd.get('advanceRecovery', null) == (r.amountSatang == 0 ? null : {'advanceId': r.advanceId, 'amountSatang': r.amountSatang}) &&
        nd.diff(d).affectedKeys().hasOnly(['advanceRecovery', 'updatedAt']) &&
        next.recoveredSatang is int && next.recoveredSatang == a.recoveredSatang + r.amountSatang - old.get('amountSatang', 0) &&
        next.recoveredSatang >= 0 && next.recoveredSatang <= a.paidSatang && next.lastRecoveryId == id &&
        next.updatedAt == request.time && next.diff(a).affectedKeys().hasOnly(['recoveredSatang', 'lastRecoveryId', 'updatedAt']) &&
        r.amountSatang != old.get('amountSatang', 0) && recoveryAuditLinked(appId, id, r, old.get('amountSatang', 0));
    }
    function recoveryActor(appId, r) {
      let u = userProfile(appId).data;
      let roles = u.get('roles', []).concat([u.get('role', 'Staff')]);
      let mp = /databases/$(database)/documents/artifacts/$(appId)/public/data/settings/rolePermissions;
      let fp = /databases/$(database)/documents/artifacts/$(appId)/public/data/settings/functionPermissions;
      let m = exists(mp) ? get(mp).data : {};
      let f = exists(fp) ? get(fp).data : {};
      return roles.hasAny(['Administrator']) || (r.projectId in u.get('assignedProjectIds', []) &&
        roles.hasAny(m.get('advance-payment', ['Administrator', 'CM', 'PM', 'PD', 'PCM', 'GM', 'MD'])) &&
        roles.hasAny(f.get('advance-payment', {}).get('applyRecovery', ['CM', 'PM', 'PCM', 'Administrator'])) &&
        roles.hasAny(r.documentType == 'payments' ? m.get('payment-subcontract', ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'PD', 'CM', 'Procurement', 'Staff']) : m.get('invoice', ['Administrator', 'MD', 'GM', 'PM', 'PCM', 'Staff'])));
    }
    function recoveryAuditLinked(appId, id, r, old) {
      let p = /databases/$(database)/documents/artifacts/$(appId)/public/data/advanceTransactions/$(r.lastTransactionId);
      let t = getAfter(p).data;
      let delta = r.amountSatang - old;
      return !exists(p) && t.advanceId == r.advanceId && t.projectId == r.projectId && t.poId == r.poId &&
        t.documentType == r.documentType && t.documentId == r.documentId && t.recoveryId == id &&
        t.type == (delta > 0 ? 'recovery' : 'reversal') && t.amountSatang == math.abs(delta) &&
        t.createdAt == request.time && t.createdByUid == request.auth.uid;
    }
    function recoveryCounter(appId, id, a) {
      let r = getAfter(recoveryPath(appId, a.lastRecoveryId)).data;
      let p = recoveryPath(appId, a.lastRecoveryId);
      return r.advanceId == id && r.updatedAt == request.time &&
        (!exists(p) || get(p).data != r) &&
        a.diff(resource.data).affectedKeys().hasOnly(['recoveredSatang', 'lastRecoveryId', 'updatedAt']);
    }
    function validAdvanceTransaction(appId, id, t) {
      let ap = advancePath(appId, t.advanceId);
      let a = getAfter(ap).data;
      let e = a.history[a.history.size()-1];
      return t.createdAt == request.time && t.projectId == a.projectId && t.poId == a.poId && (
        (t.get('action', '') in ['create', 'approve', 'reject', 'pay'] && e.id == id &&
          t.diff(e).affectedKeys().hasOnly(['advanceId', 'projectId', 'poId', 'amountSatang', 'createdAt']) && t.amountSatang == a.amountSatang &&
          (t.action == 'create' ? !exists(ap) : get(ap).data.history.size() + 1 == a.history.size())) ||
        (t.keys().hasOnly(['advanceId', 'projectId', 'poId', 'type', 'amountSatang', 'documentType', 'documentId', 'recoveryId', 'createdAt', 'createdByUid']) &&
          t.createdByUid == request.auth.uid && getAfter(recoveryPath(appId, t.recoveryId)).data.lastTransactionId == id && validRecoveryAudit(appId, t)));
    }
    function validRecoveryAudit(appId, t) {
      let p = recoveryPath(appId, t.recoveryId);
      let r = getAfter(p).data;
      let old = exists(p) ? get(p).data.get('amountSatang', 0) : 0;
      let delta = r.amountSatang - old;
      return t.advanceId == r.advanceId && t.documentType == r.documentType && t.documentId == r.documentId &&
        t.type == (delta > 0 ? 'recovery' : 'reversal') && t.amountSatang == math.abs(delta) &&
        r.updatedAt == request.time && delta != 0 && recoveryAuditLinked(appId, t.recoveryId, r, old);
    }
    function recoveryDocUpdate(appId, kind, id, b, a) {
      let changed = a.diff(b).affectedKeys();
      return (!changed.hasAny(['advanceRecovery']) || recoveryDocLinked(appId, kind + '-' + id, a)) &&
        (!ownRecovery(b) || (!changed.hasAny(['discountAllocationVersion', 'poGrossAmount', 'poDiscountAmount', 'discountPrId', 'discountPrNo', 'discountRate', 'grossPeriodAmount', 'thisPeriodDiscount', 'netPeriodAmount', 'discountAppliedAmount', 'prevAccumDiscount', 'depositMode', 'isDeposit', 'depositAmount']) &&
          (!changed.hasAny(['originalAmount']) || (!('originalAmount' in b) && a.originalAmount == b.amount)))) &&
        (!ownRecovery(b) || (!changed.hasAny(['amount', 'totalAmount', 'netAmount', 'vat', 'vatAmount', 'wht', 'whtAmount', 'retention', 'retentionAmount', 'discount', 'discountAmount', 'projectId', 'vendorId', 'contractorId', 'sourcePoId', 'vendorName', 'poId', 'poNo', 'selectedPrIds', 'items', 'sourceType', 'paymentId']) &&
          (!changed.hasAny(['status']) || a.status in ['Active', 'In Process', 'Wait Invoice', 'Invcredit', 'Inpay', 'Paid', 'paid', 'Wait Pay', 'งวดงาน Pending CM', 'งวดงาน Pending PM', 'Hold', 'จบงาน']))) &&
        a.get('inheritedAdvanceRecovery', null) == b.get('inheritedAdvanceRecovery', null) &&
        (b.get('inheritedAdvanceRecovery', null) == null || !changed.hasAny(['sourceType', 'paymentId', 'poId', 'projectId', 'vendorId', 'amount']));
    }
    function recoveryDocLinked(appId, id, a) {
      let p = recoveryPath(appId, id);
      let r = getAfter(p).data;
      return r.updatedAt == request.time && (!exists(p) || get(p).data != r) &&
        a.get('advanceRecovery', null) == (r.amountSatang == 0 ? null : {'advanceId':r.advanceId, 'amountSatang':r.amountSatang});
    }
    function inheritedCreate(appId, a) {
      let p = get(/databases/$(database)/documents/artifacts/$(appId)/public/data/payments/$(a.get('paymentId', a.get('poId', '')))).data;
      return ownRecovery(p) ? (a.inheritedAdvanceRecovery == {'advanceId': p.advanceRecovery.advanceId, 'amountSatang': p.advanceRecovery.amountSatang, 'paymentId': a.get('paymentId', a.get('poId', ''))} &&
        a.status == 'Draft' && a.projectId == p.projectId && a.vendorId == p.get('vendorId', p.get('contractorId', '')) && a.amount == p.amount) : a.get('inheritedAdvanceRecovery', null) == null;
    }
    function advanceDocCreate(appId, kind, a) {
      return a.get('advanceRecovery', null) == null &&
        (kind == 'invoice' && a.get('sourceType', '') == 'payment' ? inheritedCreate(appId, a) : a.get('inheritedAdvanceRecovery', null) == null);
    }
    function inheritedInvoiceRollback(appId, id) {
      let b = resource.data;
      let a = request.resource.data;
      let invoiceId = b.get('invoiceId', '') in ['', null] ? 'payment-invoice-' + id : b.invoiceId;
      let p = /databases/$(database)/documents/artifacts/$(appId)/public/data/invoices/$(invoiceId);
      let inv = get(p).data;
      return moduleAllowed(appId, 'invoice') && ownRecovery(b) &&
        inv.get('sourceType', '') == 'payment' && inv.projectId == b.projectId &&
        inv.inheritedAdvanceRecovery == {'paymentId':id, 'advanceId':b.advanceRecovery.advanceId, 'amountSatang':b.advanceRecovery.amountSatang} &&
        !existsAfter(p) && a.status == 'Hold' && a.invoiceId == null && a.invoiceNo == null &&
        a.invoiceAttachments == [] && a.invoicePeriodNo == null && a.holdReason is string &&
        a.diff(b).affectedKeys().hasOnly(['status', 'invoiceId', 'invoiceNo', 'invoiceAttachments', 'invoicePeriodNo', 'holdReason', 'updatedAt']);
    }

    match /artifacts/{appId}/public/data {
      match /advances/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && advanceReadable(appId);
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'advance-payment') && validAdvanceCreate(appId, documentId, request.resource.data);
        allow update: if signedIn() &&
          ((request.resource.data.get('lastRecoveryId', '') != '' && recoveryCounter(appId, documentId, request.resource.data)) ||
           (canUpdateExistingProjectDoc(appId) && moduleAllowed(appId, 'advance-payment') && validAdvanceLifecycle(appId, documentId, resource.data, request.resource.data)));
        allow delete: if false;
      }
      match /advanceRecoveries/{documentId} {
        allow get: if signedIn() && !exists(recoveryPath(appId, documentId));
        allow read: if canReadExistingProjectDoc(appId) && advanceReadable(appId);
        allow create, update: if signedIn() && validRecovery(appId, documentId, request.resource.data);
        allow delete: if false;
      }
      match /advanceTransactions/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && advanceReadable(appId);
        allow create: if signedIn() &&
          (request.resource.data.get('type', '') in ['recovery', 'reversal'] || (canCreateInProject(appId) && moduleAllowed(appId, 'advance-payment'))) &&
          validAdvanceTransaction(appId, documentId, request.resource.data);
        allow update, delete: if false;
      }

      match /users/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin(appId));
        allow list: if isAdmin(appId) && moduleAllowed(appId, 'admin');
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.get('role', 'Staff') == 'Staff' &&
          request.resource.data.get('roles', []).size() == 0 &&
          request.resource.data.get('status', 'Pending') == 'Pending' &&
          request.resource.data.get('assignedProjectIds', []).size() == 0;
        allow update: if isAdmin(appId) || (signedIn() && request.auth.uid == uid &&
          request.resource.data.get('role', 'Staff') == resource.data.get('role', 'Staff') &&
          request.resource.data.get('roles', []) == resource.data.get('roles', []) &&
          request.resource.data.get('status', '') == resource.data.get('status', '') &&
          request.resource.data.get('assignedProjectIds', []) == resource.data.get('assignedProjectIds', [])
        );
        allow delete: if isAdmin(appId);
      }

      match /userSettings/{uid} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }

      match /settings/{settingDoc} {
        allow read: if signedIn();
        allow write: if isAdmin(appId);

        match /{nestedPath=**} {
          allow read: if signedIn();
          allow write: if isAdmin(appId);
        }
      }

      // Running-number counters must remain writable by users who create PR/PO.
      match /settings/prRunningNo/prCountersByPrefix/{counterId} {
        allow read, create, update: if signedIn() && moduleAllowed(appId, 'pr');
      }

      match /settings/poRunningNo/poCountersByPrefix/{counterId} {
        allow read, create, update: if signedIn() && moduleAllowed(appId, 'po');
      }

      match /projects/{projectId} {
        // Public read is required by an external API-key-only application.
        // The main application still limits its query to assignedProjectIds.
        allow read: if true;
        allow create: if signedIn() && moduleAllowed(appId, 'projects');
        allow update, delete: if signedIn() && assignedToProject(appId, projectId) && moduleAllowed(appId, 'projects');
      }

      match /budgets/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'projects') || moduleAllowed(appId, 'budget') ||
          moduleAllowed(appId, 'pr') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'budget-summary') || moduleAllowed(appId, 'project-spending')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'budget');
        allow update: if canUpdateExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') ||
          (isBudgetReturnApprover(appId) && changesOnlyBudgetReturnFields(['budgetReturnNotifications', 'usedAmount', 'updatedAt'])) ||
          // PR creation keeps this derived cache in sync. PR-only roles may
          // update the cache fields, but cannot change any budget details.
          (moduleAllowed(appId, 'pr') &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usedAmount', 'updatedAt']))
        );
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'budget');
      }

      match /prs/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'pr') ||
          moduleAllowed(appId, 'po') || moduleAllowed(appId, 'receive') ||
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'billing') ||
          moduleAllowed(appId, 'pay') || moduleAllowed(appId, 'budget-summary') ||
          moduleAllowed(appId, 'project-spending')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'pr');
        allow update: if canUpdateExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'pr') || moduleAllowed(appId, 'po') || moduleAllowed(appId, 'budget') ||
          (isBudgetReturnApprover(appId) && changesOnlyBudgetReturnFields([
            'items', 'totalAmount', 'amount', 'status', 'budgetReturnRevisions',
            'budgetReturnRevNo', 'lastBudgetReturnAt', 'lastBudgetReturnAmount',
            'lastBudgetReturnReason', 'pendingBudgetReturns', 'pendingBudgetReturn', 'updatedAt'
          ]))
        );
        allow delete: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'pr') || moduleAllowed(appId, 'po') || moduleAllowed(appId, 'budget')
        );
      }

      match /pos/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          // Admin Site needs PO data as the source of the Receive workspace.
          // This grants data read only; PO menu visibility remains controlled
          // by rolePermissions in Set Role.
          isAdminSite(appId) ||
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'pr') ||
          moduleAllowed(appId, 'po') || moduleAllowed(appId, 'payment-subcontract') || moduleAllowed(appId, 'advance-payment') ||
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'invoice') ||
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay') ||
          moduleAllowed(appId, 'budget-summary') || moduleAllowed(appId, 'project-spending')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'po') &&
          !request.resource.data.keys().hasAny(['materialReceive']);
        allow update: if canUpdateExistingProjectDoc(appId) && validMaterialPoUpdate(appId) && (
          moduleAllowed(appId, 'po') || moduleAllowed(appId, 'payment-subcontract') ||
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'invoice') ||
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay') || moduleAllowed(appId, 'budget') ||
          (isBudgetReturnApprover(appId) && changesOnlyBudgetReturnFields([
            'budgetReturnProcessStatus', 'budgetReturnProcessStep',
            'budgetReturnProcessCompletedAt', 'budgetReturnProcessCompletedBy', 'updatedAt'
          ]))
        );
        allow delete: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'po') || moduleAllowed(appId, 'payment-subcontract') ||
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'invoice') ||
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay') || moduleAllowed(appId, 'budget')
        );
      }

      match /payments/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'payment-subcontract') || moduleAllowed(appId, 'advance-payment') ||
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'budget-summary') ||
          moduleAllowed(appId, 'project-spending')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'payment-subcontract') && advanceDocCreate(appId, 'payment', request.resource.data);
        allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advanceRecovery', 'updatedAt']) &&
            request.resource.data.get('advanceRecovery', null) != resource.data.get('advanceRecovery', null) && recoveryDocLinked(appId, 'payments-' + documentId, request.resource.data)) ||
          (canUpdateExistingProjectDoc(appId) && ((moduleAllowed(appId, 'payment-subcontract') && recoveryDocUpdate(appId, 'payments', documentId, resource.data, request.resource.data)) || inheritedInvoiceRollback(appId, documentId))));
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'payment-subcontract') && !ownRecovery(resource.data);
      }

      match /invoices/{documentId} {
        // A transaction must read the missing, deterministic Draft before it
        // can create it. Authorize only this get through its parent Payment;
        // existing invoice reads and collection queries keep their old rules.
        allow get: if documentId.matches('^payment-invoice-.+$') &&
          !exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/invoices/$(documentId)) &&
          signedIn() &&
          assignedToProject(appId,
            get(/databases/$(database)/documents/artifacts/$(appId)/public/data/payments/$(documentId.replace('^payment-invoice-', ''))).data.get('projectId', '')) &&
          (moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'payment-subcontract') || moduleAllowed(appId, 'po'));
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'payment-subcontract') || moduleAllowed(appId, 'receive') ||
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'billing') ||
          moduleAllowed(appId, 'pay') || moduleAllowed(appId, 'budget-summary') ||
          moduleAllowed(appId, 'project-spending')
        );
        allow create: if canCreateInProject(appId) && advanceDocCreate(appId, 'invoice', request.resource.data) && (
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'po') || moduleAllowed(appId, 'payment-subcontract')
        );
        allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['advanceRecovery', 'updatedAt']) &&
          request.resource.data.get('advanceRecovery', null) != resource.data.get('advanceRecovery', null) && recoveryDocLinked(appId, 'invoices-' + documentId, request.resource.data);
        allow update: if canUpdateExistingProjectDoc(appId) && recoveryDocUpdate(appId, 'invoices', documentId, resource.data, request.resource.data) && (
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay')
        );
        allow delete: if canReadExistingProjectDoc(appId) && !ownRecovery(resource.data) && (
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay')
        );
      }

      match /receives/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'invoice') ||
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay')
        );
        allow create: if canCreateInProject(appId) && materialReceiveWriteAllowed(appId) && (
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'po')
        );
        allow update: if canUpdateExistingProjectDoc(appId) && moduleAllowed(appId, 'receive');
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'receive');
      }

      match /billings/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'billing');
        allow update: if canUpdateExistingProjectDoc(appId) && moduleAllowed(appId, 'billing');
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'billing');
      }

      match /pays/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'billing') || moduleAllowed(appId, 'pay') || moduleAllowed(appId, 'po')
        );
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'pay');
        allow update: if canUpdateExistingProjectDoc(appId) && moduleAllowed(appId, 'pay');
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'pay');
      }

      match /budgetRevisions/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'projects');
        allow create: if canCreateInProject(appId) && moduleAllowed(appId, 'projects');
        allow update: if canUpdateExistingProjectDoc(appId) && moduleAllowed(appId, 'projects');
        allow delete: if canReadExistingProjectDoc(appId) && moduleAllowed(appId, 'projects');
      }

      match /vendors/{documentId} {
        allow read: if signedIn() && (
          moduleAllowed(appId, 'vendor') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'invoice') || moduleAllowed(appId, 'receive')
        );
        allow write: if signedIn() && (moduleAllowed(appId, 'vendor') || moduleAllowed(appId, 'po'));
      }

      match /materials/{documentId} {
        allow read: if signedIn() && (moduleAllowed(appId, 'material') || moduleAllowed(appId, 'po'));
        allow write: if signedIn() && moduleAllowed(appId, 'material');
      }

      match /vendorEvaluations/{documentId} {
        allow read: if signedIn() && moduleAllowed(appId, 'vendor');
        allow create: if signedIn() && (
          moduleAllowed(appId, 'vendor') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'receive') || moduleAllowed(appId, 'payment-subcontract')
        );
        allow update, delete: if signedIn() && (
          moduleAllowed(appId, 'vendor') || moduleAllowed(appId, 'po')
        );
      }

      match /poBudgetReturnJobs/{documentId} {
        allow read: if canReadExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'payment-subcontract')
        );
        allow update: if canUpdateExistingProjectDoc(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'payment-subcontract') ||
          (isBudgetReturnApprover(appId) && changesOnlyBudgetReturnFields([
            'acceptedPrIds', 'acceptedLastAt', 'acceptedLastBy', 'status',
            'currentStep', 'completedAt', 'updatedAt'
          ]))
        );
        allow create: if canCreateInProject(appId) && (
          moduleAllowed(appId, 'budget') || moduleAllowed(appId, 'po') ||
          moduleAllowed(appId, 'payment-subcontract')
        );
      }

      match /logs/{documentId} {
        allow create: if signedIn();
        allow read: if signedIn() && isAdmin(appId) && moduleAllowed(appId, 'admin');
        allow update, delete: if isAdmin(appId);
      }
    }
  }
}
